modules = ["python-3.11", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["jdk"]

[deployment]
deploymentTarget = "autoscale"
run = ["streamlit", "run", "app.py", "--server.port", "5000"]

[agent]
integrations = ["python_anthropic_ai_integrations:1.0.0", "streamlit_database:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run app.py --server.port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33799
externalPort = 3001

[[ports]]
localPort = 35895
externalPort = 3002

[[ports]]
localPort = 36631
externalPort = 3000

[[ports]]
localPort = 37759
externalPort = 3003

[[ports]]
localPort = 43327
externalPort = 4200
